# ── Production environment template ─────────────────────────────────────────
# Copy to .env.production and fill in real values before deploying.
# Variables marked REQUIRED will cause the app to refuse to start when empty.
# Variables marked OPTIONAL can be left empty to disable the feature.
#
# See RENDER_DEPLOYMENT.md for deployment instructions.

# ── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=production                    # REQUIRED — enables strict validation

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=10000                                # Render uses 10000; set $PORT if dynamic
LOG_LEVEL=info
DEBUG=false                               # REQUIRED false — app rejects DEBUG=true in production
LOG_SQL=false                             # Never true in production — severe performance impact

# ── Database ────────────────────────────────────────────────────────────────
# REQUIRED: PostgreSQL only (SQLite is rejected in production)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# ── Authentication ───────────────────────────────────────────────────────────
# REQUIRED: minimum 32 random characters (64-char hex recommended)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=                               # REQUIRED
JWT_EXPIRY_DAYS=7

# ── LLM providers (at least one REQUIRED) ────────────────────────────────────
ANTHROPIC_API_KEY=                        # OPTIONAL
CLAUDE_MODEL=claude-3-5-haiku-20241022

GROQ_API_KEY=                             # OPTIONAL (free, recommended primary)
GROQ_MODEL=openai/gpt-oss-20b

NVIDIA_API_KEY=                           # OPTIONAL (free backup)
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Ollama: only set if you have a non-localhost Ollama server reachable from Render.
# localhost URLs are rejected in production.
OLLAMA_BASE_URL=                          # OPTIONAL — must not be localhost
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# ── CORS ────────────────────────────────────────────────────────────────────
# REQUIRED: explicit list of allowed frontend origins, no '*', no localhost
CORS_ORIGINS=https://your-app.example.com

# ── Smart Home (Home Assistant) ──────────────────────────────────────────────
# Leave both empty to disable smart home entirely.
# .local hostnames are rejected in production; use a routable hostname or IP.
HASS_URL=                                 # OPTIONAL e.g. https://ha.example.com
HASS_TOKEN=                               # OPTIONAL — long-lived access token

# ── Web Search (SearXNG) ─────────────────────────────────────────────────────
# Leave empty to disable web search.
SEARXNG_URL=                              # OPTIONAL e.g. https://search.example.com

# ── Weather ──────────────────────────────────────────────────────────────────
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# DEFAULT_LATITUDE=40.7128
# DEFAULT_LONGITUDE=-74.0060

# ── Image Generation ─────────────────────────────────────────────────────────
IMAGE_GEN_ENABLED=false
GEMINI_API_KEY=                           # OPTIONAL — needed for Gemini image gen
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

# ── Knowledge Base ───────────────────────────────────────────────────────────
KNOWLEDGE_COLLECTION=athena_knowledge
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=50

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
GOOGLE_TOKEN_DIR=./secrets

# ── Proxy / rate limiting ────────────────────────────────────────────────────
# REQUIRED true when deployed behind Render / Cloudflare / nginx so rate limits
# key on the real client IP (rightmost X-Forwarded-For entry), not the proxy IP.
TRUST_PROXY=true
RATE_LIMIT_LLM=20/minute
RATE_LIMIT_IMAGE=5/minute

# ── WebSocket limits ─────────────────────────────────────────────────────────
WS_MAX_AUDIO_BYTES=10485760
WS_MAX_CONN_PER_IP=3

# ── IP debug route ────────────────────────────────────────────────────────────
# Set true temporarily to verify real-IP detection, then set back to false.
DEBUG_CLIENT_IP=false
