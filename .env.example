# ── Server ──────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
DEBUG=false
# Set true to log every SQL statement (aiosqlite/SQLAlchemy). Never use in production.
LOG_SQL=false

# ── Database ────────────────────────────────────
# For local development (SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./athena.db

# For production (Neon PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require

# ── LLM API Keys (at least one required for chat) ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=1024

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MAX_TOKENS=1024
# Nemotron reasoning models think before answering (adds 5-30 s). False disables it.
NVIDIA_REASONING=false

# ── LLM timeout & chain deadline ───────────────
# Seconds to wait for the TCP connection to be established.
LLM_CONNECT_TIMEOUT=5
# Seconds to wait for the first response byte after the request is sent.
LLM_READ_TIMEOUT=25
# Total budget (seconds) for the full Groq→NVIDIA→Ollama fallback chain.
# Each provider gets min(LLM_READ_TIMEOUT, remaining) for its read phase.
LLM_CHAIN_DEADLINE=40

# ── Ollama (local fallback LLM) ─────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# ── Whisper (STT) ──────────────────────────────
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Piper (TTS) ────────────────────────────────
# PIPER_MODEL_PATH=./models/en_US-lessac-medium.onnx
PIPER_SAMPLE_RATE=22050

# ── VAD ─────────────────────────────────────────
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=700

# ── Memory (ChromaDB) ──────────────────────────
# CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Smart Home (Home Assistant) ─────────────────
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=

# ── Web Search (SearXNG) ───────────────────────
SEARXNG_URL=http://localhost:8080

# ── Weather ────────────────────────────────────
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# DEFAULT_LATITUDE=40.7128
# DEFAULT_LONGITUDE=-74.0060

# ── Image Generation ───────────────────────────
IMAGE_GEN_ENABLED=false
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp
# STABLE_DIFFUSION_MODEL=stabilityai/stable-diffusion-2-1

# ── Authentication ──────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Access token TTL in minutes (default: 15).
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token TTL in days (default: 30).
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated OAuth client IDs (production: set at least one of these).
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# Enable email/password login — development/test only; not recommended for production.
PASSWORD_AUTH_ENABLED=false
# Rate limit for all auth endpoints (register, login, refresh, OAuth).
RATE_LIMIT_AUTH=5/minute

# ── Knowledge Base ──────────────────────────────
KNOWLEDGE_COLLECTION=athena_knowledge
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=50

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ── Google OAuth token storage ───────────────────────────────
# Directory where google token JSON files are stored (never commit this dir)
GOOGLE_TOKEN_DIR=./secrets

# ── WebSocket limits ─────────────────────────────────────────
WS_MAX_AUDIO_BYTES=10485760
# Max concurrent /ws/voice connections per client IP
WS_MAX_CONN_PER_IP=3

# ── Rate limiting ────────────────────────────────────────────
# Applied to all routes that call LLMs or external paid APIs
RATE_LIMIT_LLM=20/minute
# Stricter limit for image generation (Gemini/SD are expensive)
RATE_LIMIT_IMAGE=5/minute

# ── Proxy / IP spoofing protection ───────────────────────────
# Set true only when deployed behind a trusted reverse proxy (e.g. Render).
# When true, rate-limit keys use the rightmost X-Forwarded-For entry
# (the real client IP appended by the proxy) instead of the transport IP.
# Leave false for local development to ignore XFF headers entirely.
TRUST_PROXY=false

# ── IP debug route ────────────────────────────────────────────
# Set true temporarily to expose GET /api/_debug/client-ip.
# Deploy with true, verify get_client_ip returns your real public IP from two
# different networks, then set back to false.  Never leave true in production.
DEBUG_CLIENT_IP=false

# ── Access logging ─────────────────────────────────────────────
# Set false to disable the one-line-per-request access log entirely.
ACCESS_LOG=true
# Comma-separated path prefixes excluded from access logging (e.g. health checks).
ACCESS_LOG_EXCLUDE=/health
